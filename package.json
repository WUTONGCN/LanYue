{
  "name": "lanyue-desktop",
  "version": "0.1.6",
  "private": true,
  "description": "览阅：本地、离线、多格式文件预览",
  "author": "WUTONGCN",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "engine:build": "node scripts/build-engine.cjs",
    "runtime:prepare": "node scripts/prepare-runtime.cjs",
    "runtime:check": "node scripts/check-runtime.cjs",
    "pack:mac": "node scripts/pack.cjs mac-arm64",
    "pack:win": "node scripts/pack.cjs win-x64",
    "release:mac": "npm run pack:mac && node scripts/archive-mac.cjs",
    "icons:build": "node scripts/build-icons.cjs",
    "system:build": "node scripts/build-system.cjs"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "com.lanyue.preview",
    "productName": "LanYue",
    "asar": true,
    "compression": "maximum",
    "files": [
      "app/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "LICENSE",
      "NOTICE"
    ],
    "extraResources": [
      {
        "from": "runtime/${os}-${arch}",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dir"
      ],
      "identity": null,
      "icon": "build/lanyue-v2.icns",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "空格预览需要读取 Finder 中选中的文件，仅用于在本机预览。"
      }
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/lanyue-v2.ico",
      "signExecutable": false
    },
    "artifactName": "LanYue-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": [
          "3dm",
          "3ds",
          "3gp",
          "3mf",
          "7-zip",
          "7z",
          "asp",
          "aspx",
          "avi",
          "avif",
          "bas",
          "bat",
          "bim",
          "bmp",
          "bpmn",
          "brep",
